# Dependencies
node_modules/

# HyperFrames internal state (render outputs, locks, history, video state)
.hyperframes/

# Render output directory
renders/

# Playwright MCP scratch (probe sessions)
.playwright-mcp/

# OS artifacts
.DS_Store
Thumbs.db

# Raw original photos (multi-MB source files, never tracked).
# Non-recursive by design: assets/raw/optimized/ (web-sized derivatives)
# and slug-map.json remain tracked — do NOT add a trailing slash or /**
assets/raw/*.jpg
assets/raw/*.jpeg
assets/raw/*.png
assets/raw/*.JPG
assets/raw/*.JPEG
assets/raw/*.PNG
